# Copia este archivo como ".env" y rellena con los datos reales que te dé
# tu proveedor de MySQL (Railway, PlanetScale, tu hosting...). El archivo
# ".env" NUNCA se sube a ningún sitio público — lleva las contraseñas.

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Dominios desde los que se aceptan peticiones (separados por coma).
# Mientras pruebas en local, puedes dejarlo en *. Antes de hacerlo público
# de verdad, ponlo con vuestro dominio real, por ejemplo:
# ORIGENES_PERMITIDOS=https://acros.es,https://www.acros.es
ORIGENES_PERMITIDOS=*

PORT=3000
